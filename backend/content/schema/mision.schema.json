{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Misión Situacional (docs/minijuegos-diseno.md §5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "nivel", "leccion_id", "titulo", "escenario", "personaje", "objetivos", "autoria", "pasos"],
  "properties": {
    "id": { "type": "string", "pattern": "^mision-a[12]-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "nivel": { "enum": ["A1", "A2"] },
    "leccion_id": { "type": "string", "description": "Lección cuyo vocabulario y gramática practica; la misión se desbloquea con ella." },
    "titulo": { "type": "string", "minLength": 1, "maxLength": 40 },
    "escenario": { "type": "string", "minLength": 1, "maxLength": 200 },
    "personaje": { "type": "string", "minLength": 1, "maxLength": 30 },
    "objetivos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "texto"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "texto": { "type": "string", "minLength": 1, "maxLength": 50 }
        }
      }
    },
    "autoria": {
      "description": "Campo interno de trazabilidad. No se exporta a la app.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fuentes"],
      "properties": {
        "fuentes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notas": { "type": "string" }
      }
    },
    "pasos": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["npc", "npc_es", "opciones"],
        "properties": {
          "npc": { "type": "string", "minLength": 1 },
          "npc_es": { "type": "string", "minLength": 1 },
          "opciones": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["en", "correcta"],
              "properties": {
                "en": { "type": "string", "minLength": 1 },
                "correcta": { "type": "boolean" },
                "cumple": { "type": "string", "description": "id del objetivo que cumple (solo en la correcta)" },
                "concepto_id": { "type": "string", "pattern": "^(voc|gram)\\.[a-z0-9_.]+$" },
                "feedback": { "type": "string", "minLength": 1, "description": "Por qué está mal (obligatorio en las incorrectas)" }
              }
            }
          }
        }
      }
    }
  }
}
